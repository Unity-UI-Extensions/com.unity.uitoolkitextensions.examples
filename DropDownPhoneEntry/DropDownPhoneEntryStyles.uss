.phoneVerificationExample__screen {
	flex-grow: 1;
	align-items: center;
	justify-content: center;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 48px;
	padding-bottom: 48px;
	background-color: rgba(9, 15, 27, 1);
}

.phoneVerificationExample__card {
	width: 100%;
	max-width: 560px;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 34px;
	padding-bottom: 32px;
	background-color: rgba(20, 28, 44, 0.94);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.08);
	border-radius: 28px;
}

.phoneVerificationExample__eyebrow {
	font-size: 13px;
	color: rgba(132, 173, 255, 1);
	-unity-font-style: bold;
	-unity-text-align: upper-left;
	margin-bottom: 12px;
}

.phoneVerificationExample__title {
	font-size: 30px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	-unity-text-align: upper-left;
	margin-bottom: 10px;
	white-space: normal;
}

.phoneVerificationExample__description {
	font-size: 15px;
	color: rgba(202, 211, 232, 0.9);
	-unity-text-align: upper-left;
	white-space: normal;
	margin-bottom: 24px;
}

.phoneVerificationExample__phoneCompositeInput {
	width: 100%;
	height: 72px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-left: 0;
	padding-right: 0;
	border-width: 1px;
	border-radius: 22px;
	border-color: rgba(255, 255, 255, 0.14);
	background-color: rgba(255, 255, 255, 0.03);
	margin-bottom: 18px;
}

.phoneVerificationExample__dialCodePicker {
	width: auto;
	min-width: 164px;
	max-width: 220px;
	flex-grow: 0;
	flex-shrink: 0;
	margin: 0;
	padding: 0;
}

.phoneVerificationExample__dialCodePicker .dropDownControl__trigger {
	height: 72px;
	border-width: 0;
	border-radius: 0;
	background-color: rgba(0, 0, 0, 0);
	justify-content: flex-end;
}

.phoneVerificationExample__dialCodePicker .dropDownControl__triggerLabel {
	font-size: 20px;
	-unity-text-align: middle-right;
	padding-left: 24px;
	padding-right: 12px;
	flex-grow: 0;
}

.phoneVerificationExample__dialCodePicker .dropDownControl__triggerIcon {
	margin-right: 14px;
	margin-left: 0;
	width: 18px;
	height: 18px;
}

.phoneVerificationExample__inputDivider {
	width: 1px;
	height: 40px;
	margin-left: 8px;
	margin-right: 8px;
	background-color: rgba(255, 255, 255, 0.14);
}

.phoneVerificationExample__phoneInput {
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	margin: 0;
	padding: 0;
}

.phoneVerificationExample__phoneInput > .pillInputField__input {
	height: 72px;
	border-width: 0;
	border-radius: 0;
	background-color: rgba(0, 0, 0, 0);
}

.phoneVerificationExample__phoneInput .pillInputField__inputTextContent > .unity-text-field__input,
.phoneVerificationExample__phoneInput .pillInputField__inputTextContent > .unity-base-text-field__input {
	-unity-text-align: middle-left;
	padding-left: 18px;
	padding-right: 10px;
	font-size: 18px;
	color: rgba(255, 255, 255, 1);
	/* Override the default (light) theme: the inner input ships an opaque white
	   background, which made the white typed text invisible (white-on-white).
	   Transparent lets the dark card show through, matching the dropdown panel. */
	background-color: rgba(0, 0, 0, 0);
	border-left-width: 0;
	border-right-width: 0;
	border-top-width: 0;
	border-bottom-width: 0;
}

.phoneVerificationExample__phoneInput .unity-text-field__placeholder,
.phoneVerificationExample__phoneInput .unity-base-text-field__placeholder {
	-unity-text-align: middle-left;
	color: rgba(180, 191, 220, 0.65);
}

.phoneVerificationExample__info {
	font-size: 14px;
	color: rgba(173, 183, 210, 0.85);
	-unity-text-align: upper-left;
	white-space: normal;
	margin-bottom: 24px;
}

.phoneVerificationExample__sendButton {
	width: 100%;
	height: 58px;
	margin-bottom: 14px;
}

.phoneVerificationExample__status {
	font-size: 13px;
	color: rgba(132, 173, 255, 0.95);
	-unity-text-align: upper-left;
	white-space: normal;
}
