.imageCropOverlayDemo__screen {
	flex-grow: 1;
	align-items: center;
	justify-content: center;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 40px;
	padding-bottom: 40px;
	background-color: rgba(9, 15, 27, 1);
}

.imageCropOverlayDemo__card {
	width: 100%;
	max-width: 720px;
	padding-left: 32px;
	padding-right: 32px;
	padding-top: 34px;
	padding-bottom: 32px;
	background-color: rgba(20, 27, 41, 0.96);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.08);
	border-radius: 28px;
	box-shadow: 0 28px 64px rgba(0, 0, 0, 0.34);
}

.imageCropOverlayDemo__eyebrow {
	font-size: 13px;
	color: rgba(122, 232, 199, 1);
	-unity-font-style: bold;
	-unity-text-align: upper-left;
	margin-bottom: 12px;
}

.imageCropOverlayDemo__title {
	font-size: 30px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	-unity-text-align: upper-left;
	margin-bottom: 10px;
	white-space: normal;
}

.imageCropOverlayDemo__description {
	font-size: 15px;
	line-height: 22px;
	color: rgba(202, 211, 232, 0.9);
	-unity-text-align: upper-left;
	white-space: normal;
	margin-bottom: 28px;
}

.imageCropOverlayDemo__stage {
	align-items: center;
	justify-content: center;
	margin-bottom: 26px;
}

.imageCropOverlayDemo__imageButton {
	width: 176px;
	height: 176px;
	margin-bottom: 14px;
}

.imageCropOverlayDemo__helper {
	font-size: 14px;
	color: rgba(167, 176, 204, 0.88);
	-unity-text-align: middle-center;
	white-space: normal;
	margin-bottom: 22px;
}

.imageCropOverlayDemo__previewCard {
	width: 100%;
	max-width: 320px;
	padding-left: 18px;
	padding-right: 18px;
	padding-top: 18px;
	padding-bottom: 18px;
	background-color: rgba(255, 255, 255, 0.03);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.08);
	border-radius: 22px;
	align-items: center;
	justify-content: center;
}

.imageCropOverlayDemo__previewTitle {
	font-size: 13px;
	color: rgba(150, 162, 194, 0.95);
	-unity-font-style: bold;
	-unity-text-align: middle-center;
	margin-bottom: 12px;
}

.imageCropOverlayDemo__previewImage {
	width: 220px;
	height: 220px;
	border-radius: 32px;
	background-color: rgba(255, 255, 255, 0.05);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.06);
}

.imageCropOverlayDemo__buttonRow {
	flex-direction: row;
	justify-content: space-between;
	gap: 14px;
	margin-bottom: 16px;
}

.imageCropOverlayDemo__actionButton {
	flex-grow: 1;
	height: 58px;
}

.imageCropOverlayDemo__status {
	font-size: 13px;
	line-height: 18px;
	color: rgba(122, 232, 199, 0.95);
	-unity-text-align: upper-left;
	white-space: normal;
}
