.toastDemo__screen {
	flex-grow: 1;
	align-items: center;
	justify-content: center;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 48px;
	padding-bottom: 48px;
	background-color: rgba(9, 15, 27, 1);
	position: relative;
}

.toastDemo__card {
	width: 100%;
	max-width: 580px;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 34px;
	padding-bottom: 32px;
	background-color: rgba(20, 28, 44, 0.94);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.08);
	border-radius: 28px;
}

.toastDemo__eyebrow {
	font-size: 13px;
	color: rgba(132, 173, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 12px;
}

.toastDemo__headerTitle {
	font-size: 30px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 10px;
	white-space: normal;
}

.toastDemo__instruction {
	font-size: 15px;
	color: rgba(202, 211, 232, 0.9);
	margin-bottom: 22px;
	white-space: normal;
}

/* Full-screen layer the notifications stack into. It sits above the card but is
   non-interactive itself (picking ignored in the demo/binder) so the card's
   "Add Toast" button stays clickable — only the toasts capture pointer input. */
.toastDemo__overlay {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
	padding-top: 40px;
	padding-left: 20px;
	padding-right: 20px;
}

.toastDemo__container {
	width: 100%;
	max-width: 440px;
	flex-direction: column;
	align-items: stretch;
}

.toastDemo__bottomBar {
	margin-top: 6px;
	padding-top: 0;
	align-items: center;
}

.toastDemo__addButton {
	height: 52px;
	align-self: stretch;
}

.toastDemo__toast {
	flex-direction: row;
	align-items: center;
	border-top-left-radius: 14px;
	border-top-right-radius: 14px;
	border-bottom-left-radius: 14px;
	border-bottom-right-radius: 14px;
	padding-top: 14px;
	padding-bottom: 14px;
	padding-left: 16px;
	padding-right: 12px;
	margin-bottom: 10px;
	overflow: hidden;
}

.toastDemo__accent {
	width: 4px;
	align-self: stretch;
	border-top-left-radius: 2px;
	border-bottom-left-radius: 2px;
	margin-right: 12px;
	flex-shrink: 0;
}

.toastDemo__textBlock {
	flex-grow: 1;
	flex-direction: column;
}

.toastDemo__title {
	font-size: 14px;
	color: rgba(26, 26, 38, 1);
	-unity-font-style: bold;
}

.toastDemo__subtitle {
	font-size: 12px;
	color: rgba(102, 102, 128, 1);
	margin-top: 2px;
	white-space: normal;
}

.toastDemo__dismiss {
	font-size: 22px;
	color: rgba(128, 128, 140, 0.8);
	margin-left: 8px;
	flex-shrink: 0;
	-unity-text-align: middle-center;
	width: 24px;
}
