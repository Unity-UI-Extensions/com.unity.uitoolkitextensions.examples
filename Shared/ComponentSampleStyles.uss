/* ============================================================
   ComponentSampleStyles.uss
   Page chrome shared by the component samples. Reads ThemeTokens
   only, so the samples show the reusable token defaults.
   ============================================================ */

.componentSample__screen {
    flex-grow: 1;
    background-color: var(--c-bg);
    padding-top: var(--space-6);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
}

.componentSample__title {
    font-size: var(--text-title);
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--c-fg);
}

.componentSample__body {
    font-size: var(--text-label);
    -unity-font-definition: var(--font-body);
    color: var(--c-fg-muted);
    white-space: normal;
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
}

.componentSample__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: var(--space-2);
}

.componentSample__button {
    height: 40px;
    margin-left: 0;
    margin-right: var(--space-2);
    margin-bottom: var(--space-2);
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    border-width: 0;
    border-radius: var(--radius-pill);
    background-color: var(--c-primary);
    color: var(--c-on-primary);
    font-size: var(--text-label);
}

.componentSample__button--secondary {
    background-color: var(--c-surface);
    color: var(--c-fg);
}

.componentSample__toggle {
    margin-right: var(--space-4);
    color: var(--c-fg);
}

.componentSample__toggle Label {
    color: var(--c-fg);
}

.componentSample__log {
    font-size: var(--text-caption);
    color: var(--c-accent);
    margin-top: var(--space-2);
    white-space: normal;
}

.componentSample__stage {
    flex-grow: 1;
    margin-top: var(--space-4);
}
