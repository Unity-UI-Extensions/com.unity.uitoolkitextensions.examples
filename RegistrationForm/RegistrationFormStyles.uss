/* Dark theme — matches the DropDownPhoneEntry demo (screen rgba(9,15,27,1)). */

.registrationForm__screen {
	flex-grow: 1;
	align-items: center;
	justify-content: center;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 48px;
	padding-bottom: 48px;
	background-color: rgba(9, 15, 27, 1);
}

.registrationForm__card {
	width: 100%;
	max-width: 580px;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 34px;
	padding-bottom: 32px;
	background-color: rgba(20, 28, 44, 0.94);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.08);
	border-radius: 28px;
}

.registrationForm__eyebrow {
	font-size: 13px;
	color: rgba(132, 173, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 12px;
}

.registrationForm__formContainer {
	flex-direction: column;
}

.registrationForm__title {
	font-size: 30px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 10px;
	white-space: normal;
}

.registrationForm__subtitle {
	font-size: 15px;
	color: rgba(202, 211, 232, 0.9);
	margin-bottom: 28px;
	white-space: normal;
}

.registrationForm__nameField {
	margin-bottom: 16px;
	border-top-left-radius: 24px;
	border-top-right-radius: 24px;
	border-bottom-left-radius: 24px;
	border-bottom-right-radius: 24px;
}

.registrationForm__emailField {
	margin-bottom: 16px;
	border-top-left-radius: 24px;
	border-top-right-radius: 24px;
	border-bottom-left-radius: 24px;
	border-bottom-right-radius: 24px;
}

.registrationForm__passwordField {
	margin-bottom: 16px;
	border-top-left-radius: 24px;
	border-top-right-radius: 24px;
	border-bottom-left-radius: 24px;
	border-bottom-right-radius: 24px;
}

.registrationForm__sectionLabel {
	font-size: 12px;
	color: rgba(173, 183, 210, 0.85);
	margin-bottom: 6px;
}

.registrationForm__bioField {
	height: 96px;
	margin-bottom: 16px;
	border-top-left-radius: 12px;
	border-top-right-radius: 12px;
	border-bottom-left-radius: 12px;
	border-bottom-right-radius: 12px;
}

.registrationForm__categorySelector {
	margin-bottom: 32px;
}

.registrationForm__submitButton {
	height: 52px;
	margin-bottom: 16px;
}

.registrationForm__successContainer {
	display: none;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	padding-top: 20px;
	padding-bottom: 8px;
	padding-left: 16px;
	padding-right: 16px;
}

.registrationForm__successIcon {
	width: 72px;
	height: 72px;
	border-top-left-radius: 36px;
	border-top-right-radius: 36px;
	border-bottom-left-radius: 36px;
	border-bottom-right-radius: 36px;
	background-color: rgba(46, 204, 112, 1);
	justify-content: center;
	align-items: center;
	margin-bottom: 24px;
}

.registrationForm__successCheck {
	font-size: 36px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
}

.registrationForm__successTitle {
	font-size: 26px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 12px;
	-unity-text-align: middle-center;
}

.registrationForm__successMessage {
	font-size: 15px;
	color: rgba(173, 183, 210, 0.85);
	-unity-text-align: middle-center;
	white-space: normal;
}
