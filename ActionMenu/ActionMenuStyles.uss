.actionMenuExample__screen {
	flex-grow: 1;
	align-items: center;
	justify-content: center;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 48px;
	padding-bottom: 48px;
	background-color: rgba(9, 15, 27, 1);
}

.actionMenuExample__card {
	width: 100%;
	max-width: 560px;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 34px;
	padding-bottom: 32px;
	background-color: rgba(20, 28, 44, 0.94);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.08);
	border-radius: 28px;
}

.actionMenuExample__eyebrow {
	font-size: 13px;
	color: rgba(132, 173, 255, 1);
	-unity-font-style: bold;
	-unity-text-align: upper-left;
	margin-bottom: 12px;
}

.actionMenuExample__title {
	font-size: 30px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	-unity-text-align: upper-left;
	margin-bottom: 10px;
	white-space: normal;
}

.actionMenuExample__description {
	font-size: 15px;
	color: rgba(202, 211, 232, 0.9);
	-unity-text-align: upper-left;
	white-space: normal;
	margin-bottom: 24px;
}

.actionMenuExample__itemList {
	width: 100%;
	margin-bottom: 6px;
}

.actionMenuExample__itemRow {
	width: 100%;
	height: 72px;
	flex-direction: row;
	align-items: center;
	padding-left: 20px;
	padding-right: 12px;
	border-width: 1px;
	border-radius: 22px;
	border-color: rgba(255, 255, 255, 0.14);
	background-color: rgba(255, 255, 255, 0.03);
	margin-bottom: 14px;
}

.actionMenuExample__itemLabel {
	flex-grow: 1;
	flex-shrink: 1;
	min-width: 0;
	font-size: 17px;
	color: rgba(236, 240, 252, 1);
	-unity-text-align: middle-left;
}

.actionMenuExample__itemMenuButton {
	width: 44px;
	height: 44px;
	flex-shrink: 0;
	border-radius: 22px;
	background-color: rgba(255, 255, 255, 0.06);
	color: rgba(202, 211, 232, 0.95);
	font-size: 22px;
	-unity-font-style: bold;
	-unity-text-align: middle-center;
}

.actionMenuExample__itemMenuButton:hover {
	background-color: rgba(255, 255, 255, 0.12);
}

.actionMenuExample__centeredButton {
	width: 100%;
	height: 58px;
	margin-top: 8px;
	margin-bottom: 14px;
}

.actionMenuExample__status {
	font-size: 13px;
	color: rgba(132, 173, 255, 0.95);
	-unity-text-align: upper-left;
	white-space: normal;
}
