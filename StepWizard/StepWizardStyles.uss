/* Dark theme — matches the DropDownPhoneEntry demo (screen rgba(9,15,27,1)). */

.stepWizard__screen {
	flex-grow: 1;
	flex-direction: column;
	background-color: rgba(9, 15, 27, 1);
}

.stepWizard__header {
	padding-top: 48px;
	padding-bottom: 12px;
	padding-left: 20px;
	padding-right: 20px;
	align-items: center;
}

.stepWizard__title {
	font-size: 22px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 4px;
}

.stepWizard__counter {
	font-size: 13px;
	color: rgba(173, 183, 210, 0.85);
}

.stepWizard__stepperWrapper {
	padding-left: 20px;
	padding-right: 20px;
	padding-top: 8px;
	padding-bottom: 8px;
}

.stepWizard__stepper {
	height: 42px;
	border-top-left-radius: 21px;
	border-top-right-radius: 21px;
	border-bottom-left-radius: 21px;
	border-bottom-right-radius: 21px;
	background-color: rgba(255, 255, 255, 0.08);
}

.stepWizard__progressWrapper {
	padding-left: 20px;
	padding-right: 20px;
	padding-top: 4px;
	padding-bottom: 4px;
}

.stepWizard__progressBar {
	height: 6px;
	border-top-left-radius: 3px;
	border-top-right-radius: 3px;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
}

.stepWizard__content {
	flex-grow: 1;
	padding-left: 20px;
	padding-right: 20px;
	padding-top: 16px;
	padding-bottom: 16px;
}

.stepWizard__navBar {
	flex-direction: row;
	justify-content: space-between;
	padding-left: 20px;
	padding-right: 20px;
	padding-top: 12px;
	padding-bottom: 32px;
}

.stepWizard__navButton {
	width: 100px;
	height: 48px;
}

.stepWizard__panel {
	flex-grow: 1;
	flex-direction: column;
}

.stepWizard__panelHeading {
	font-size: 20px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 6px;
}

.stepWizard__panelDescription {
	font-size: 14px;
	color: rgba(173, 183, 210, 0.85);
	margin-bottom: 20px;
	white-space: normal;
}

.stepWizard__hint {
	font-size: 12px;
	color: rgba(150, 160, 188, 0.8);
	margin-top: 8px;
	white-space: normal;
}

.stepWizard__fieldRow {
	margin-bottom: 12px;
}

.stepWizard__fieldLabel {
	font-size: 12px;
	color: rgba(132, 173, 255, 0.9);
	margin-bottom: 4px;
}

.stepWizard__field {
	height: 44px;
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
}

.stepWizard__goalCard {
	flex-direction: row;
	align-items: center;
	background-color: rgba(255, 255, 255, 0.05);
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
	padding-top: 12px;
	padding-bottom: 12px;
	padding-left: 14px;
	padding-right: 14px;
	margin-bottom: 8px;
}

.stepWizard__goalCheckbox {
	width: 22px;
	height: 22px;
	border-top-left-radius: 11px;
	border-top-right-radius: 11px;
	border-bottom-left-radius: 11px;
	border-bottom-right-radius: 11px;
	background-color: rgba(255, 255, 255, 0.08);
	border-left-width: 1.5px;
	border-right-width: 1.5px;
	border-top-width: 1.5px;
	border-bottom-width: 1.5px;
	border-left-color: rgba(255, 255, 255, 0.25);
	border-right-color: rgba(255, 255, 255, 0.25);
	border-top-color: rgba(255, 255, 255, 0.25);
	border-bottom-color: rgba(255, 255, 255, 0.25);
	margin-right: 12px;
	flex-shrink: 0;
}

.stepWizard__goalText {
	font-size: 14px;
	color: rgba(225, 230, 240, 1);
	flex-grow: 1;
	white-space: normal;
}

.stepWizard__toggleRow {
	flex-direction: row;
	align-items: center;
	background-color: rgba(255, 255, 255, 0.05);
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
	padding-top: 12px;
	padding-bottom: 12px;
	padding-left: 14px;
	padding-right: 14px;
	margin-bottom: 8px;
}

.stepWizard__toggleText {
	flex-grow: 1;
	flex-direction: column;
}

.stepWizard__toggleLabel {
	font-size: 14px;
	color: rgba(225, 230, 240, 1);
}

.stepWizard__toggleDetail {
	font-size: 12px;
	color: rgba(150, 160, 188, 0.85);
}

.stepWizard__toggleIndicator {
	width: 36px;
	height: 20px;
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
	background-color: rgba(46, 204, 112, 1);
	flex-shrink: 0;
}

.stepWizard__summaryBox {
	background-color: rgba(46, 204, 112, 0.12);
	border-top-left-radius: 12px;
	border-top-right-radius: 12px;
	border-bottom-left-radius: 12px;
	border-bottom-right-radius: 12px;
	padding-top: 16px;
	padding-bottom: 16px;
	padding-left: 16px;
	padding-right: 16px;
	margin-top: 12px;
}

.stepWizard__summaryRow {
	flex-direction: row;
	justify-content: space-between;
	margin-bottom: 8px;
}

.stepWizard__summaryKey {
	font-size: 14px;
	color: rgba(190, 200, 220, 1);
}

.stepWizard__summaryValue {
	font-size: 14px;
	color: rgba(86, 222, 150, 1);
	-unity-font-style: bold;
}
