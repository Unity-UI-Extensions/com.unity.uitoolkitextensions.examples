/* Dark theme — matches the DropDownPhoneEntry demo (screen rgba(9,15,27,1)). */

/* Top-anchored (not centered): the card's top edge stays fixed across steps, so the
   header/stepper/progress bar hold their position and taller step panels only expand
   the card downward. */
.stepWizard__screen {
	flex-grow: 1;
	align-items: center;
	justify-content: flex-start;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 72px;
	padding-bottom: 48px;
	background-color: rgba(9, 15, 27, 1);
}

.stepWizard__card {
	width: 100%;
	max-width: 620px;
	padding-left: 28px;
	padding-right: 28px;
	padding-top: 34px;
	padding-bottom: 32px;
	background-color: rgba(20, 28, 44, 0.94);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.08);
	border-radius: 28px;
}

/* The header (everything down to the progress bar) never shrinks — when a tall step
   makes the card exceed the viewport, only the content area gives way. */
.stepWizard__header {
	flex-shrink: 0;
}

.stepWizard__eyebrow {
	font-size: 13px;
	color: rgba(132, 173, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 12px;
}

.stepWizard__title {
	font-size: 30px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 10px;
	white-space: normal;
}

.stepWizard__subtitle {
	font-size: 15px;
	color: rgba(202, 211, 232, 0.9);
	margin-bottom: 20px;
	white-space: normal;
}

.stepWizard__counter {
	font-size: 13px;
	color: rgba(132, 173, 255, 0.95);
	margin-bottom: 16px;
}

.stepWizard__stepperWrapper {
	padding-left: 10px;
	padding-right: 10px;
	padding-top: 10px;
	padding-bottom: 10px;
	margin-bottom: 10px;
	background-color: rgba(255, 255, 255, 0.045);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.12);
	border-radius: 22px;
}

.stepWizard__stepper {
	height: 42px;
	border-top-left-radius: 21px;
	border-top-right-radius: 21px;
	border-bottom-left-radius: 21px;
	border-bottom-right-radius: 21px;
	background-color: rgba(255, 255, 255, 0.07);
}

.stepWizard__progressWrapper {
	padding-top: 4px;
	padding-bottom: 10px;
}

.stepWizard__progressBar {
	height: 6px;
	border-top-left-radius: 3px;
	border-top-right-radius: 3px;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
}

.stepWizard__content {
	flex-grow: 1;
	flex-shrink: 1;
	min-height: 0;
	overflow: hidden;
	padding-top: 12px;
	padding-bottom: 18px;
}

.stepWizard__navBar {
	flex-shrink: 0;
	flex-direction: row;
	justify-content: space-between;
	padding-top: 12px;
	padding-bottom: 0;
}

.stepWizard__navButton {
	width: 100px;
	height: 48px;
}

.stepWizard__panel {
	flex-grow: 1;
	flex-direction: column;
	padding-top: 20px;
	padding-bottom: 20px;
	padding-left: 18px;
	padding-right: 18px;
	background-color: rgba(255, 255, 255, 0.07);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.12);
	border-radius: 22px;
}

.stepWizard__panelHeading {
	font-size: 20px;
	color: rgba(255, 255, 255, 1);
	-unity-font-style: bold;
	margin-bottom: 6px;
}

.stepWizard__panelDescription {
	font-size: 14px;
	color: rgba(173, 183, 210, 0.85);
	margin-bottom: 20px;
	white-space: normal;
}

.stepWizard__hint {
	font-size: 12px;
	color: rgba(150, 160, 188, 0.8);
	margin-top: 8px;
	white-space: normal;
}

.stepWizard__fieldRow {
	margin-bottom: 12px;
}

.stepWizard__fieldLabel {
	font-size: 12px;
	color: rgba(173, 183, 210, 0.85);
	margin-bottom: 4px;
}

.stepWizard__field {
	height: 44px;
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
}

.stepWizard__goalCard {
	flex-direction: row;
	align-items: center;
	background-color: rgba(255, 255, 255, 0.05);
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
	padding-top: 12px;
	padding-bottom: 12px;
	padding-left: 14px;
	padding-right: 14px;
	margin-bottom: 8px;
}

.stepWizard__goalCheckbox {
	width: 22px;
	height: 22px;
	border-top-left-radius: 11px;
	border-top-right-radius: 11px;
	border-bottom-left-radius: 11px;
	border-bottom-right-radius: 11px;
	background-color: rgba(255, 255, 255, 0.08);
	border-left-width: 1.5px;
	border-right-width: 1.5px;
	border-top-width: 1.5px;
	border-bottom-width: 1.5px;
	border-left-color: rgba(255, 255, 255, 0.25);
	border-right-color: rgba(255, 255, 255, 0.25);
	border-top-color: rgba(255, 255, 255, 0.25);
	border-bottom-color: rgba(255, 255, 255, 0.25);
	margin-right: 12px;
	flex-shrink: 0;
}

.stepWizard__goalText {
	font-size: 14px;
	color: rgba(225, 230, 240, 1);
	flex-grow: 1;
	white-space: normal;
}

.stepWizard__toggleRow {
	flex-direction: row;
	align-items: center;
	background-color: rgba(255, 255, 255, 0.05);
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
	padding-top: 12px;
	padding-bottom: 12px;
	padding-left: 14px;
	padding-right: 14px;
	margin-bottom: 8px;
}

.stepWizard__toggleText {
	flex-grow: 1;
	flex-direction: column;
}

.stepWizard__toggleLabel {
	font-size: 14px;
	color: rgba(225, 230, 240, 1);
}

.stepWizard__toggleDetail {
	font-size: 12px;
	color: rgba(150, 160, 188, 0.85);
}

.stepWizard__toggleIndicator {
	width: 36px;
	height: 20px;
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	border-bottom-left-radius: 10px;
	border-bottom-right-radius: 10px;
	background-color: rgba(46, 204, 112, 1);
	flex-shrink: 0;
}

.stepWizard__summaryBox {
	background-color: rgba(255, 255, 255, 0.045);
	border-width: 1px;
	border-color: rgba(255, 255, 255, 0.12);
	border-top-left-radius: 12px;
	border-top-right-radius: 12px;
	border-bottom-left-radius: 12px;
	border-bottom-right-radius: 12px;
	padding-top: 16px;
	padding-bottom: 16px;
	padding-left: 16px;
	padding-right: 16px;
	margin-top: 12px;
}

.stepWizard__summaryRow {
	flex-direction: row;
	justify-content: space-between;
	margin-bottom: 8px;
}

.stepWizard__summaryKey {
	font-size: 14px;
	color: rgba(190, 200, 220, 1);
}

.stepWizard__summaryValue {
	font-size: 14px;
	color: rgba(132, 173, 255, 0.95);
	-unity-font-style: bold;
}
