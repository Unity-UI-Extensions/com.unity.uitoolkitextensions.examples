/* EntryGate sample: the screen switcher and loading card; the gate styles itself from ThemeTokens. */

.entryGateDemo__tabs {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-2);
}

.entryGateDemo__log {
    position: absolute;
    left: var(--space-4);
    bottom: 56px;
    font-size: var(--text-caption);
    color: var(--c-accent);
}

.entryGateDemo__steps {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    background-color: var(--c-surface);
    border-width: 1px;
    border-color: var(--c-divider);
    border-radius: var(--radius-sheet);
}
