/* PromptChoices sample: header and spacing only; the components style themselves from ThemeTokens. */

.promptDemo__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

.promptDemo__name {
    margin-left: var(--space-3);
    font-size: var(--text-body);
    -unity-font-style: bold;
    color: var(--c-fg);
}

.promptDemo__hold {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top-width: 3px;
    border-top-color: var(--c-divider);
}
